[Unit]
Description=Transit snapshot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transit
Group=transit
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/transit-archive /var/www/transit-api
WorkingDirectory=/path/to/milovermeulen.com
ExecStart=/usr/bin/python3.12 -m services.transit.server
Environment=TRANSIT_WWW_DIR=/var/www/transit-api
Environment=TRANSIT_API_HOST=127.0.0.1
Environment=TRANSIT_API_PORT=8082
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

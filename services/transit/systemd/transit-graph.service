[Unit]
Description=Build transit track graph from static GTFS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=transit
Group=transit
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/transit-archive /var/www/transit-api
WorkingDirectory=/path/to/milovermeulen.com
Environment=TRANSIT_DATA_DIR=/var/lib/transit-archive
Environment=TRANSIT_WWW_DIR=/var/www/transit-api
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3.12 -m services.transit.build_graph

[Unit]
Description=Transit GTFS-RT poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transit
Group=transit
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/transit-archive /var/www/transit-api
# Root of the installed services package, so `-m services.transit.*` resolves.
# deploy/install-service.sh substitutes this path if the install root ever moves.
WorkingDirectory=/opt/milovermeulen
ExecStart=/usr/bin/python3.12 -m services.transit.poller
Environment=TRANSIT_DATA_DIR=/var/lib/transit-archive
Environment=TRANSIT_WWW_DIR=/var/www/transit-api
# ProtectSystem=strict leaves the install read-only; be explicit about bytecode.
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
